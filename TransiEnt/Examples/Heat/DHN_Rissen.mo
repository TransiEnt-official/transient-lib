  Modelica.Blocks.Sources.CombiTimeTable heatFlowRateForecast_Improved_Supply(
    tableOnFile=true,
    tableName="default",
    fileName=path,
    smoothness=Modelica.Blocks.Types.Smoothness.ContinuousDerivative,
    shiftTime=g) annotation (Placement(transformation(extent={{-8,36},{-28,56}})));
Modelica.Blocks.Sources.RealExpression crit_con_dp(y=min(he_170111.inlet.p-he_170111.outlet.p,he_171557.inlet.p-he_171557.outlet.p));//he_172006.inlet.p - he_172006.outlet.p,he_170057.inlet.p-he_170057.outlet.p,

equation
  // ------------------------------------------------------------------------------------------
  //   Equations
  // ------------------------------------------------------------------------------------------

  // Calculation of an optimal supply temperature based on a pre-charge strategy
  if heatFlowRateForecast2.y[1] > 32e6 then
    T_s_opt=100; //120
  elseif Supply0.controlVolumeL4_HeatLoss.T[1]-273.15 > T_supply_2 + 4 and heatFlowRateForecast_TimeDelay_Storage2.y[1] < 32e6 then
    T_s_opt=100; //120
  else
  T_s_opt=40; //Unused
  end if;

  //Calculation of the total electric power
  P_el_ges=provider_0.producer.P_el+provider_0.electricBoiler.P_el+provider_0.simplePump_dp.P_el;

  //Calculation of the improved supply temperature
  T_supply_2=max(60, f*heatFlowRateForecast_Improved_Supply.y[1]/1e6 + c);

  //Calculation of the specific enthalpy (Input for the producer)
  if time > 36400 then
      h_supply=T_supply.y*4186;//
    else
      h_supply=70*4186;//1;
  end if;

  provider_0.h_in=h_supply;

  //Calculation of the supply temperatures
  T_supply_1=max(T_s_opt,T_supply_2); //T_supply_3
  T_supply_3=min(max(a*provider_0.T_outdoor.y[1]+e,60),T_s_max);//

  //Calculation of cost variables
  //cost2=provider_0.producer.cost+provider_0.electricBoiler.cost+cost4;
  //cost4=provider_0.simplePump_dp.P_el*provider_0.producer.c_el.y[1]/3.6e9;

  //Output for post processing
  h_producer_out=provider_0.outlet.h_outflow;
  h_producer_in=Return0.outlet.h_outflow;
  m_flow_producer=provider_0.outlet.m_flow;
  delta_p_producer=provider_0.outlet.p - provider_0.inlet.p;

//Connect statements
