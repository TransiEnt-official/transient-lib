within TransiEnt.Examples.Heat;
model DHN_Rissen "This model was automatically generated"

  // ------------------------------------------------------------------------------------------
  //   Parameters
  // ------------------------------------------------------------------------------------------

  // ---- Parameters ---------------------------------------------------------------------
  parameter Real a=-1.9261 "Parameter a for Reference curve";
  parameter Real b=-17000 "Delay Time for storage scenario";
  parameter Real c=42.0312 "Parameter c for improved supply temperature curve";
  parameter Real d=-2500 "Delay Time for storage scenario -2000";
  parameter Real e=76.4780 "Parameter c for reference curve";
  parameter Real f=1.3672 "Parameter f for improved supply temperature curve";
  parameter Real g=-3234.4 "Parameter for improved supply temperature curve";
  parameter Real T_s_max=90;
  parameter String relativepath = "/heat/Rissen_Prognose2.txt";
  final parameter String path = TransiEnt.Basics.Functions.fullPathName(Modelica.Utilities.System.getEnvironmentVariable("public-data") + relativepath);

  // ------------------------------------------------------------------------------------------
  //   Interfaces
  // ------------------------------------------------------------------------------------------

  //Outputs for post processing
  output Real h_producer_out;
  output Real h_producer_in;
  output Real m_flow_producer;
  output Real delta_p_producer;

  // ------------------------------------------------------------------------------------------
  //  Variables
  // ------------------------------------------------------------------------------------------

  //Calculation of the different supply temperatures
  Real T_supply_2 "Improved supply temperature";
  Real T_supply_1 "Improved supply temperature with pre-charge strategy";
  Real T_supply_3 "Reference supply temperature";
  Real T_s_opt    "Auxillary variable for determining T_supply_1";
  Real P_el_ges   "Total electric power consumed by the DHN, P_el_HeatPump+P_el_CirculationPump+P_el_ElectricBoiler";

  Real h_supply "Specific Enthalpy calculated from T_supply";
  //Real cost2 "Total costs of the heat supply";
  //Real cost4 "Cost of the electric power of the circulation pump";

  // ------------------------------------------------------------------------------------------
  //   Pipe
  // ------------------------------------------------------------------------------------------
