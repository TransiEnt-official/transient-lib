  connect(realExpression.y, T_supply.u) annotation (Line(points={{-19,114},{10,114}},                            color={0,0,127}));
  annotation (                                 experiment(
      StartTime=1600000,
      StopTime=2628000,
      Interval=300,
      __Dymola_Algorithm="Dassl"),
    Diagram(coordinateSystem(extent={{-1800,-900},{1920,100}})),
    Icon(coordinateSystem(extent={{-1800,-900},{1920,100}}), graphics={
                                   Ellipse(
          lineColor={0,125,125},
          fillColor={255,255,255},
          fillPattern=FillPattern.Solid,
          extent={{-344,-718},{312,-78}}), Polygon(
          origin={66,-128},
          lineColor={78,138,73},
          fillColor={0,124,124},
          fillPattern=FillPattern.Solid,
          points={{-236,-62},{190,-276},{-236,-492},{-236,-62}})}),
    Documentation(info="<html>
<h4><span style=\"color: #008000\">Purpose of model</span></h4>
<p>A generated, realistic DHN model for a suburb of Hamburg. The objective of the model is the evaluation of an improved temperature curve as well as a pre charge strategy to reduce the electric peak load. There are three curves for the supply temperature: T_supply_1, T_supply_2 and T_supply_3. T_supply_1 is a load-based temperature curve that uses a pre-charge strategy. T_supply_2 is a load-based temperature curve without a pre-charge strategy. And T_supply_3 is a normal weather-based supply temperature curve. The parameters of the supply temperature curves have been determined by dynamic simulations. The supply temperature used in the DHN can be set in the realExpression used as an input for the slew-rate limiter T_supply. A lot of variables are protected to get a smaller output file. </p>
<p>Look at:</p>
<p>T_supply.y: That is the supply temperature of the DHN.</p>
<p>P_el_ges: The total electric power consumed by the DHN.</p>
<p>provider_0.simplePump_dp.P_el: Electric power consumed by the circulation pump.</p>
<p>he_172717.heatExchanger.T_s: Supply temperature arriving at a consumer</p>
<p>he_172717.heatExchanger.T_r: Return temperature at a consumer</p>
<h4><span style=\"color: #008000\">Version History</span></h4>
<p>Model was inserted by Jan Westphal (j.westphal@tuhh.de) November 2026</p>
</html>"));
end DHN_Rissen;
